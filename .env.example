# Copy this file to .env.local and fill in the values.
# .env.local is not committed. Never put real keys in this file.
#
# Everything starting with VITE_ is bundled into the browser app,
# so only put values here that are safe for anyone to see.
# The Supabase secret (service role) key must never go here.

# Supabase project URL
# Local: http://127.0.0.1:55321 (from `npx supabase status`)
VITE_SUPABASE_URL=

# Supabase publishable key (safe for the browser; data is protected by RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=

# true for the public demo, false (or empty) for a store
VITE_DEMO_MODE=false
